<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.akash.morningpipeline</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/akash/morning_pipeline/main.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/akash/morning_pipeline</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>55</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/akash/morning_pipeline_logs/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/akash/morning_pipeline_logs/stderr.log</string>
</dict>
</plist>
