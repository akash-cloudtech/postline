# Copy to .env and fill in. NEVER put real keys in this file - it is committed.

# --- Instagram ---
# Access token from your Meta app (API setup with Unified/Instagram login)
IG_ACCESS_TOKEN=your_instagram_access_token
# Numeric Instagram account ID (shown next to the account in the Meta dashboard)
IG_USER_ID=
IG_HANDLE=your.instagram.handle
IG_API_VERSION=v23.0
# Optional: token expiry date (YYYY-MM-DD) for the app's expiry warnings
IG_TOKEN_EXPIRES_AT=

# --- Gemini (captions) ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.1-flash-lite
# Voice/style guidance for generated captions (also editable in the app's Settings)
CAPTION_STYLE=
NUM_HASHTAGS=5

# --- Source: public share link of your Google Photos album ---
GPHOTOS_ALBUM_URL=

# --- Location privacy (optional): never tag a location within this radius of home ---
HOME_LAT=
HOME_LON=
HOME_RADIUS_KM=5

# --- Old CLI pipeline (pipeline.py) ---
DEFAULT_CAPTION=
POLL_INTERVAL_S=300

# --- Phase 1 morning scripts (on hold) ---
PRINTER_NAME=
OUTPUT_DIR=
LOG_DIR=
